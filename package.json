{
  "name": "securityincident.net",
  "version": "1.0.0",
  "description": "A neutral, high-signal index of security incident statuses and verifiable milestone timelines, powered by open weights correlation and community-driven GitHub PR editing.",
  "main": "scripts/build.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "node scripts/serve.js",
    "test": "node scripts/validate.js",
    "validate": "node scripts/validate.js",
    "test:urls": "node scripts/test-urls.js",
    "ingest": "node scripts/ingest.js",
    "ingest:history": "node scripts/ingest-history.js",
    "reconcile": "node scripts/reconcile-enrichment.js",
    "dev": "node scripts/build.js && node scripts/serve.js"
  },
  "keywords": [
    "security-incidents",
    "threat-intel",
    "sec-8k",
    "breach-tracker",
    "github-pages"
  ],
  "author": "securityincident.net",
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.7",
    "yaml": "^2.9.1"
  }
